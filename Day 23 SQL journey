create databases if not exists xcompany;
use xcompany;

CREATE TABLE EmployeeLog (
    EmpID INT PRIMARY KEY,
    FullName VARCHAR(100),
    Role VARCHAR(50),
    Salary INT,
    JoinDate DATE,
    OfficeCity VARCHAR(50)
);


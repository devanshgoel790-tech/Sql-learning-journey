Q1: Find all details of employees whose role is 'Developer'.

SELECT * FROM EmployeeLog 
WHERE Role = 'Developer';


Q2: Calculate the average salary of all employees in the company.

SELECT AVG(Salary) AS AvgSalary FROM EmployeeLog;


Q3: Count how many employees are based in the 'Boston' office city.

SELECT COUNT(*) FROM EmployeeLog 
WHERE OfficeCity = 'Boston';


Q4: List all unique roles available in the company.

SELECT DISTINCT Role FROM EmployeeLog;


Q5: Order all employees by their salary from highest to lowest.

SELECT * FROM EmployeeLog 
ORDER BY Salary DESC;


Q6: Find the maximum and minimum salary offered in the company.

SELECT MAX(Salary) AS MaxSalary, MIN(Salary) AS MinSalary FROM EmployeeLog;


Q7: Find employees who joined the company between '2021-01-01' and '2022-12-31'.

SELECT * FROM EmployeeLog 
WHERE JoinDate BETWEEN '2021-01-01' AND '2022-12-31';


Q8: Find the total salary payout grouped by each OfficeCity.

SELECT OfficeCity, SUM(Salary) AS TotalSalary FROM EmployeeLog 
GROUP BY OfficeCity;


Q9: Filter employees whose FullName starts with the character 'A'.

SELECT * FROM EmployeeLog
WHERE FullName LIKE 'A%';


Q10: Show cities that have more than 2 employees working in them.

SELECT OfficeCity FROM EmployeeLog
GROUP BY OfficeCity HAVING COUNT(*) > 2;

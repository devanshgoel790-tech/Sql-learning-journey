create databases if not exists employee_dept;
use employee_dept;

CREATE TABLE TeamMembers (
    MemberID INT PRIMARY KEY,
    FullName VARCHAR(100),
    Department VARCHAR(50),
    MonthlySalary INT,
    PerformanceRating DECIMAL(2, 1),
    RemoteStatus VARCHAR(10)
);


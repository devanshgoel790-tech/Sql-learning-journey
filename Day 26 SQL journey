
Create databases if not exists Acompany;
use Acompany;

CREATE TABLE CorporateMatrix (
    EmployeeID INT PRIMARY KEY,
    EmpName VARCHAR(100),
    Department VARCHAR(50),
    BaseSalary DECIMAL(10,2),
    PerformanceScore INT, -- Scale of 1 to 100
    QuarterlyBonus DECIMAL(10,2),
    TenureYears INT
);


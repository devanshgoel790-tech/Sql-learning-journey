create databases if not exists Teams;
use Teams;

CREATE TABLE ProjectTeams (
    StaffID INT PRIMARY KEY,
    EmployeeName VARCHAR(100),
    Department VARCHAR(50),
    AnnualBonus INT,
    YearsOfExperience INT,
    ProjectStatus VARCHAR(20)
);

